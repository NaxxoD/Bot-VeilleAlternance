# Copier ce fichier en .env et renseigner les valeurs (jamais versionnées)

# La Bonne Alternance : clé à générer sur https://api.apprentissage.beta.gouv.fr/fr/compte/profil
LBA_API_KEY=

# France Travail : application sur https://francetravail.io, avec l'API « Offres d'emploi v2 » ajoutée
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Proton Mail Bridge (IMAP local, dépôt des candidatures en Brouillons)
# Valeurs affichées dans Bridge : compte > « Configurer le client mail »
BRIDGE_IMAP_HOST=127.0.0.1
BRIDGE_IMAP_PORT=1143
BRIDGE_USER=
BRIDGE_PASSWORD=

# Île-de-France Mobilités (PRIM) : jeton sur https://prim.iledefrance-mobilites.fr
# (API « Calculateur Île-de-France Mobilités – Accès générique v2 »)
PRIM_API_KEY=
